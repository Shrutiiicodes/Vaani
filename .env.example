# Required
GROQ_API_KEY=your_groq_api_key
JWT_SECRET=a_long_random_string          # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
STAFF_PASSWORD=choose_a_strong_password  # bootstrap admin; re-synced on every start, so rotating it here works

# Optional
STAFF_USERNAME=admin
BANK_NAME=Demo Bank
LLM_MODEL=openai/gpt-oss-120b            # any Groq chat model; qwen/qwen3.8-27b is faster
TTS_ENGINE=edge                          # "gtts" is ~1s faster per reply but sounds robotic
DATABASE_URL=                            # empty = SQLite in the temp dir; postgres://... for Postgres
ALLOWED_ORIGINS=http://localhost:8000
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
